# Optional alternatives to entering the key in the Streamlit UI.
# By default the unified interface uses DeepSeek's official API.
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash

# To use a third-party OpenAI-compatible relay, set these values.
# Saved UI configuration takes precedence over these initial defaults.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
